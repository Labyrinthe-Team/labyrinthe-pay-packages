<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Labyrinthe.LabPay.AspNetCore</RootNamespace>
    <PackageId>Labyrinthe.LabPay.AspNetCore</PackageId>
    <Title>LabPay for ASP.NET Core</Title>
    <Description>ASP.NET Core integration of the LabPay SDK: services.AddLabPay(configuration) with IHttpClientFactory and Microsoft.Extensions.Logging, and a minimal API endpoint that verifies signed LabPay notifications (app.MapLabPayWebhooks).</Description>
    <PackageTags>$(PackageTags);aspnetcore;webhooks;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Labyrinthe.LabPay\Labyrinthe.LabPay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Labyrinthe.LabPay.Tests" />
  </ItemGroup>

</Project>
