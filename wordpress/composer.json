{
    "name": "labyrinthe/labpay-woocommerce",
    "description": "LabPay for WooCommerce: Mobile Money payment gateway (M-Pesa, Airtel Money, Orange Money) for shops across Africa.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "labpay",
        "labyrinthe",
        "wordpress",
        "woocommerce",
        "payment-gateway",
        "mobile-money",
        "m-pesa",
        "airtel-money",
        "orange-money",
        "africa",
        "drc",
        "congo",
        "rdc"
    ],
    "homepage": "https://docs.pay.labyrinthe-rdc.com",
    "authors": [
        {
            "name": "Labyrinthe Innovations SARL",
            "email": "contact@labyrinthe-rdc.com",
            "homepage": "https://pay.labyrinthe-rdc.com"
        }
    ],
    "support": {
        "email": "contact@labyrinthe-rdc.com",
        "docs": "https://docs.pay.labyrinthe-rdc.com"
    },
    "require": {
        "php": ">=8.1",
        "labyrinthe/labpay-php": "^0.1.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^9.0 || ^10.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "^6.4 || ^7.0",
        "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": false,
                "versions": {
                    "labyrinthe/labpay-php": "0.1.0"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "LabPay\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "prefix-dependencies": "@php bin/prefix-dependencies.php",
        "post-install-cmd": "@prefix-dependencies",
        "post-update-cmd": "@prefix-dependencies",
        "install-wp-tests": "@php bin/install-wp-tests.php",
        "lint": "phpcs",
        "format": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "i18n": "@php bin/i18n.php",
        "build": "@php bin/build-zip.php",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "prefix-dependencies": "Copy the runtime dependencies (LabPay PHP SDK, Guzzle, PSR) into vendor-prefixed/ under the LabPay\\WooCommerce\\Vendor namespace (PHP-Scoper).",
        "install-wp-tests": "Download (or copy) WordPress and WooCommerce into .wp-tests/ and create the test database.",
        "lint": "PHPCS with the WordPress Coding Standards.",
        "format": "Fix what PHPCS can fix.",
        "analyse": "PHPStan (WordPress + WooCommerce stubs).",
        "test": "PHPUnit with the WordPress test suite and WooCommerce (needs MySQL, see README).",
        "i18n": "Regenerate languages/*.pot and compile the .mo / .json files (WP-CLI).",
        "build": "Build dist/labpay-for-woocommerce.zip.",
        "check": "Lint, analyse and test."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "platform-check": false,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
