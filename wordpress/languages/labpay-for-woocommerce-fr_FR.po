#. Plugin Name of the plugin
#: labpay-for-woocommerce.php:3
msgid "LabPay for WooCommerce"
msgstr "LabPay pour WooCommerce"

#. Plugin URI of the plugin
#: labpay-for-woocommerce.php:4
msgid "https://docs.pay.labyrinthe-rdc.com"
msgstr "https://docs.pay.labyrinthe-rdc.com"

#. Description of the plugin
#: labpay-for-woocommerce.php:5
msgid "Mobile Money payments for WooCommerce with LabPay: M-Pesa, Airtel Money and Orange Money in the DR Congo (CDF and USD)."
msgstr "Paiements Mobile Money pour WooCommerce avec LabPay : M-Pesa, Airtel Money et Orange Money en RD Congo (CDF et USD)."

#. Author of the plugin
#: labpay-for-woocommerce.php:10
msgid "Labyrinthe Innovations SARL"
msgstr "Labyrinthe Innovations SARL"

#. Author URI of the plugin
#: labpay-for-woocommerce.php:11
msgid "https://pay.labyrinthe-rdc.com"
msgstr "https://pay.labyrinthe-rdc.com"

#: includes/class-ajax.php:93
msgid "Order not found."
msgstr "Commande introuvable."

#: includes/class-ajax.php:237
msgid "Payment received. Thank you!"
msgstr "Paiement reçu. Merci !"

#: includes/class-ajax.php:239
msgid "Payment received: the shop is checking it."
msgstr "Paiement reçu : la boutique le vérifie."

#: includes/class-ajax.php:241
msgid "The payment did not go through (refused, cancelled or expired). You have not been charged."
msgstr "Le paiement n'a pas abouti (refusé, annulé ou expiré). Vous n'avez pas été débité."

#: includes/class-ajax.php:243
msgid "Confirm the payment on your phone: enter your Mobile Money PIN when asked."
msgstr "Confirmez le paiement sur votre téléphone : saisissez votre code PIN Mobile Money quand il vous est demandé."

#: includes/class-client-factory.php:53
msgid "No LabPay test key is configured."
msgstr "Aucune clé de test LabPay n'est configurée."

#: includes/class-client-factory.php:54
msgid "No LabPay API token is configured."
msgstr "Aucun token API LabPay n'est configuré."

#: includes/class-gateway.php:30
msgid "LabPay (Mobile Money)"
msgstr "LabPay (Mobile Money)"

#: includes/class-gateway.php:31
msgid "M-Pesa, Airtel Money and Orange Money payments in the DR Congo with LabPay. The customer confirms the payment on their phone with their PIN."
msgstr "Paiements M-Pesa, Airtel Money et Orange Money en RD Congo avec LabPay. Le client confirme le paiement sur son téléphone avec son code PIN."

#: includes/class-gateway.php:41
#: includes/class-gateway.php:69
msgid "Mobile Money (M-Pesa, Airtel Money, Orange Money)"
msgstr "Mobile Money (M-Pesa, Airtel Money, Orange Money)"

#: includes/class-gateway.php:60
msgid "Enable"
msgstr "Activer"

#: includes/class-gateway.php:62
msgid "Accept Mobile Money payments with LabPay"
msgstr "Accepter les paiements Mobile Money avec LabPay"

#: includes/class-gateway.php:66
msgid "Title"
msgstr "Titre"

#: includes/class-gateway.php:68
msgid "Name of the payment method shown at checkout."
msgstr "Nom du moyen de paiement affiché à la validation de commande."

#: includes/class-gateway.php:73
msgid "Description"
msgstr "Description"

#: includes/class-gateway.php:75
msgid "Text shown under the payment method at checkout."
msgstr "Texte affiché sous le moyen de paiement à la validation de commande."

#: includes/class-gateway.php:76
msgid "Pay with your Mobile Money account: you will receive a confirmation request (PIN) on your phone."
msgstr "Payez avec votre compte Mobile Money : vous recevrez une demande de confirmation (code PIN) sur votre téléphone."

#: includes/class-gateway.php:80
msgid "API keys"
msgstr "Clés API"

#: includes/class-gateway.php:82
msgid "Find your token, your test key and your signing secret in your LabPay merchant area (Developers). They are stored encrypted and never shown again."
msgstr "Votre token, votre clé de test et votre secret de signature se trouvent dans votre espace marchand LabPay (Développeurs). Ils sont enregistrés chiffrés et ne sont plus jamais affichés."

#: includes/class-gateway.php:85
msgid "Test mode"
msgstr "Mode test"

#: includes/class-gateway.php:87
msgid "Use the test key (sandbox: no real money moves)"
msgstr "Utiliser la clé de test (bac à sable : aucun argent réel n'est déplacé)"

#: includes/class-gateway.php:89
msgid "Orders paid in test mode are marked \"test mode\" in their notes. Uncheck when your account is activated for production."
msgstr "Les commandes payées en mode test portent la mention « mode test » dans leurs notes. Décochez quand votre compte est activé pour la production."

#: includes/class-gateway.php:92
msgid "API token (live)"
msgstr "Token API (production)"

#: includes/class-gateway.php:94
msgid "Production token. Leave unchanged to keep the saved value; empty the field to remove it."
msgstr "Token de production. Laissez le champ inchangé pour garder la valeur enregistrée ; videz-le pour la supprimer."

#: includes/class-gateway.php:99
msgid "Test key"
msgstr "Clé de test"

#: includes/class-gateway.php:101
msgid "Starts with test_. Used when test mode is enabled."
msgstr "Commence par test_. Utilisée quand le mode test est activé."

#: includes/class-gateway.php:106
msgid "Signing secret"
msgstr "Secret de signature"

#. translators: %s: webhook URL.
#: includes/class-gateway.php:110
#, php-format
msgid "whsec_… secret used to check the notifications sent by LabPay to %s (sent automatically with each payment when your site uses HTTPS)."
msgstr "Secret whsec_… qui sert à vérifier les notifications envoyées par LabPay à %s (adresse transmise automatiquement avec chaque paiement quand votre site est en HTTPS)."

#: includes/class-gateway.php:117
msgid "Advanced"
msgstr "Avancé"

#: includes/class-gateway.php:121
msgid "Reference prefix"
msgstr "Préfixe des références"

#: includes/class-gateway.php:123
msgid "LabPay references are \"<prefix>-<order ID>-<attempt>\". Change it if several shops share the same LabPay token (letters, digits, . _ : -)."
msgstr "Les références LabPay sont « <préfixe>-<n° de commande>-<tentative> ». Changez-le si plusieurs boutiques partagent le même token LabPay (lettres, chiffres, . _ : -)."

#: includes/class-gateway.php:128
msgid "Debug log"
msgstr "Journal détaillé"

#: includes/class-gateway.php:130
msgid "Log every LabPay request (WooCommerce > Status > Logs, source \"labpay\")"
msgstr "Journaliser chaque requête LabPay (WooCommerce > État > Journaux, source « labpay »)"

#: includes/class-gateway.php:132
msgid "Errors are always logged. Keys, secrets and signatures are never logged; phone numbers are masked."
msgstr "Les erreurs sont toujours journalisées. Les clés, secrets et signatures ne le sont jamais ; les numéros sont masqués."

#. translators: %s: setting name.
#: includes/class-gateway.php:146
#, php-format
msgid "%s can no longer be read (the WordPress salts of wp-config.php changed): enter it again."
msgstr "%s ne peut plus être lu (les salts WordPress de wp-config.php ont changé) : saisissez-le à nouveau."

#: includes/class-gateway.php:151
msgid "Test mode is enabled but no test key is saved: the payment method is hidden at checkout."
msgstr "Le mode test est activé mais aucune clé de test n'est enregistrée : le moyen de paiement est masqué à la validation de commande."

#: includes/class-gateway.php:152
msgid "No live API token is saved: the payment method is hidden at checkout."
msgstr "Aucun token API de production n'est enregistré : le moyen de paiement est masqué à la validation de commande."

#. translators: %s: shop currency code.
#: includes/class-gateway.php:156
#, php-format
msgid "LabPay accepts CDF and USD only; the shop currency is %s: the payment method is hidden at checkout."
msgstr "LabPay accepte uniquement le CDF et l'USD ; la devise de la boutique est %s : le moyen de paiement est masqué à la validation de commande."

#: includes/class-gateway.php:159
msgid "No signing secret: LabPay notifications are refused, statuses are only updated by the waiting page."
msgstr "Aucun secret de signature : les notifications LabPay sont refusées, les statuts ne sont mis à jour que par la page d'attente."

#: includes/class-gateway.php:162
msgid "Your site does not use HTTPS: LabPay cannot send it notifications, statuses are only updated by the waiting page."
msgstr "Votre site n'utilise pas HTTPS : LabPay ne peut pas lui envoyer de notifications, les statuts ne sont mis à jour que par la page d'attente."

#: includes/class-gateway.php:205
#: assets/js/blocks.js:97
msgid "Test mode: no real money moves."
msgstr "Mode test : aucun argent réel n'est déplacé."

#: includes/class-gateway.php:220
#: assets/js/blocks.js:113
msgid "Mobile Money number"
msgstr "Numéro Mobile Money"

#: includes/class-gateway.php:220
msgid "required"
msgstr "obligatoire"

#: includes/class-gateway.php:222
#: assets/js/blocks.js:115
msgid "You will receive a confirmation request (PIN) on this phone."
msgstr "Vous recevrez une demande de confirmation (code PIN) sur ce téléphone."

#: includes/class-gateway.php:225
#: assets/js/blocks.js:119
msgid "Operator"
msgstr "Opérateur"

#: includes/class-gateway.php:227
#: assets/js/blocks.js:129
msgid "Detect automatically"
msgstr "Détection automatique"

#: includes/class-gateway.php:240
#: includes/class-gateway.php:263
#: assets/js/blocks.js:81
msgid "Enter a valid Mobile Money number (for example 0812345678 or +243812345678)."
msgstr "Saisissez un numéro Mobile Money valide (par exemple 0812345678 ou +243812345678)."

#. translators: %s: error code.
#: includes/class-gateway.php:289
#, php-format
msgid "LabPay payment request not accepted: %s."
msgstr "Demande de paiement LabPay non acceptée : %s."

#: includes/class-gateway.php:302
msgid "Your operator refused the payment. Check your balance and your number, then try again."
msgstr "Votre opérateur a refusé le paiement. Vérifiez votre solde et votre numéro, puis réessayez."

#. translators: 1: LabPay payment ID, 2: masked phone number.
#: includes/class-gateway.php:315
#, php-format
msgid "LabPay payment %1$s requested: waiting for the customer to confirm on %2$s."
msgstr "Paiement LabPay %1$s demandé : en attente de la confirmation du client sur le %2$s."

#: includes/class-gateway.php:343
msgid "Only a paid order can be refunded with LabPay."
msgstr "Seule une commande payée peut être remboursée avec LabPay."

#: includes/class-gateway.php:347
msgid "The refund amount must be greater than zero."
msgstr "Le montant du remboursement doit être supérieur à zéro."

#. translators: %s: error from LabPay.
#: includes/class-gateway.php:365
#, php-format
msgid "LabPay refused the refund: %s"
msgstr "LabPay a refusé le remboursement : %s"

#. translators: %s: failure code.
#: includes/class-gateway.php:372
#, php-format
msgid "The LabPay refund failed (%s): no money was sent."
msgstr "Le remboursement LabPay a échoué (%s) : aucun argent n'a été envoyé."

#. translators: 1: LabPay refund ID, 2: amount, 3: currency, 4: status.
#: includes/class-gateway.php:379
#, php-format
msgid "LabPay refund %1$s requested: %2$s %3$s (%4$s). Fees are not refunded."
msgstr "Remboursement LabPay %1$s demandé : %2$s %3$s (%4$s). Les frais ne sont pas remboursés."

#: includes/class-gateway.php:383
msgid "completed"
msgstr "effectué"

#: includes/class-gateway.php:383
msgid "in progress, the final status arrives by notification"
msgstr "en cours, le statut final arrive par notification"

#: includes/class-gateway.php:406
msgid "The live API token cannot be a test key (test_…): paste it in \"Test key\"."
msgstr "Le token de production ne peut pas être une clé de test (test_…) : collez-la dans « Clé de test »."

#: includes/class-gateway.php:416
msgid "The test key starts with test_."
msgstr "La clé de test commence par test_."

#: includes/class-gateway.php:426
msgid "The signing secret looks invalid (whsec_…)."
msgstr "Le secret de signature semble invalide (whsec_…)."

#. translators: %s: order number. Letters (without accents), digits and spaces only: 4 to 22 characters.
#: includes/class-order-payments.php:354
#, php-format
msgid "Order %s"
msgstr "Commande %s"

#: includes/class-order-payments.php:368
msgid "This Mobile Money number is not valid. Check it and try again."
msgstr "Ce numéro Mobile Money n'est pas valide. Vérifiez-le et réessayez."

#: includes/class-order-payments.php:371
msgid "This amount is outside the limits of your Mobile Money operator. Choose another payment method or contact the shop."
msgstr "Ce montant dépasse les limites de votre opérateur Mobile Money. Choisissez un autre moyen de paiement ou contactez la boutique."

#: includes/class-order-payments.php:374
msgid "This operator cannot be used for this payment. Choose \"Detect automatically\" or another number."
msgstr "Cet opérateur ne peut pas être utilisé pour ce paiement. Choisissez « Détection automatique » ou un autre numéro."

#: includes/class-order-payments.php:377
msgid "We could not reach the Mobile Money service. Please try again: you will not be charged twice."
msgstr "Le service Mobile Money n'a pas pu être joint. Réessayez : vous ne serez pas débité deux fois."

#: includes/class-order-payments.php:380
msgid "Mobile Money payment is temporarily unavailable. Please try again in a few minutes."
msgstr "Le paiement Mobile Money est momentanément indisponible. Réessayez dans quelques minutes."

#: includes/class-order-payments.php:383
msgid "Mobile Money payment is not available for this order. Please choose another payment method or contact the shop."
msgstr "Le paiement Mobile Money n'est pas disponible pour cette commande. Choisissez un autre moyen de paiement ou contactez la boutique."

#. translators: 1: LabPay payment ID, 2: amount paid, 3: currency, 4: expected amount, 5: order currency.
#: includes/class-order-payments.php:441
#, php-format
msgid "LabPay payment %1$s completed for %2$s %3$s, but the order expects %4$s %5$s: check it before delivering."
msgstr "Paiement LabPay %1$s effectué pour %2$s %3$s, mais la commande attend %4$s %5$s : vérifiez-le avant de livrer."

#. translators: 1: LabPay refund ID, 2: amount, 3: currency.
#: includes/class-order-payments.php:518
#, php-format
msgid "LabPay refund %1$s completed: %2$s %3$s sent back to the customer."
msgstr "Remboursement LabPay %1$s effectué : %2$s %3$s renvoyés au client."

#. translators: 1: LabPay refund ID, 2: failure code.
#: includes/class-order-payments.php:526
#, php-format
msgid "LabPay refund %1$s failed (%2$s): no money was sent and your LabPay balance was credited back. The WooCommerce refund still exists: delete it or refund the customer another way."
msgstr "Le remboursement LabPay %1$s a échoué (%2$s) : aucun argent n'a été envoyé et votre solde LabPay a été recrédité. Le remboursement WooCommerce existe toujours : supprimez-le ou remboursez le client autrement."

#. translators: 1: LabPay payment ID, 2: amount, 3: currency.
#: includes/class-order-payments.php:583
#, php-format
msgid "A second LabPay payment %1$s (%2$s %3$s) completed for this already paid order. Refund it from your LabPay dashboard."
msgstr "Un second paiement LabPay %1$s (%2$s %3$s) a abouti pour cette commande déjà payée. Remboursez-le depuis votre espace LabPay."

#. translators: 1: LabPay payment ID, 2: amount, 3: currency, 4: provider code, 5: provider transaction ID, 6: " (test)" or "".
#: includes/class-order-payments.php:607
#, php-format
msgid "LabPay payment %1$s completed: %2$s %3$s via %4$s (operator reference: %5$s)%6$s."
msgstr "Paiement LabPay %1$s effectué : %2$s %3$s via %4$s (référence opérateur : %5$s)%6$s."

#: includes/class-order-payments.php:613
msgid "(test mode)"
msgstr "(mode test)"

#. translators: 1: LabPay payment ID, 2: failure code, 3: failure message.
#: includes/class-order-payments.php:627
#, php-format
msgid "LabPay payment %1$s failed: %2$s %3$s"
msgstr "Paiement LabPay %1$s échoué : %2$s %3$s"

#. translators: %s: operator name.
#: includes/class-plugin.php:173
#: assets/js/blocks.js:62
#, php-format,js-format
msgid "Detected operator: %s"
msgstr "Opérateur détecté : %s"

#: includes/class-plugin.php:174
#: assets/js/blocks.js:63
msgid "This number does not look like a valid Mobile Money number."
msgstr "Ce numéro ne ressemble pas à un numéro Mobile Money valide."

#: includes/class-plugin.php:189
msgid "Settings"
msgstr "Réglages"

#: includes/class-plugin.php:201
msgid "LabPay for WooCommerce needs WooCommerce: install and activate it."
msgstr "LabPay pour WooCommerce a besoin de WooCommerce : installez-le et activez-le."

#: includes/class-waiting-page.php:60
#: includes/class-waiting-page.php:87
msgid "Try again"
msgstr "Réessayer"

#: includes/class-waiting-page.php:88
msgid "Still no confirmation. If you confirmed the payment, it will be taken into account automatically and you will receive an email; otherwise, try again."
msgstr "Toujours pas de confirmation. Si vous avez confirmé le paiement, il sera pris en compte automatiquement et vous recevrez un e-mail ; sinon, réessayez."

#: includes/class-waiting-page.php:97
msgid "Waiting for your confirmation"
msgstr "En attente de votre confirmation"

#. translators: %s: LabPay payment ID.
#: includes/class-waiting-page.php:103
#, php-format
msgid "LabPay reference: %s"
msgstr "Référence LabPay : %s"

#. translators: 1: required PHP version, 2: current PHP version.
#: labpay-for-woocommerce.php:67
#, php-format
msgid "LabPay for WooCommerce needs PHP %1$s or newer (this site runs PHP %2$s). Ask your host to upgrade PHP: the plugin stays inactive until then."
msgstr "LabPay pour WooCommerce nécessite PHP %1$s ou plus récent (ce site utilise PHP %2$s). Demandez à votre hébergeur de mettre PHP à jour : l'extension reste inactive d'ici là."

#: labpay-for-woocommerce.php:86
msgid "LabPay for WooCommerce is incomplete (vendor-prefixed/ is missing). Install the plugin from its zip file, or run \"composer install\" in its folder."
msgstr "LabPay pour WooCommerce est incomplet (vendor-prefixed/ manque). Installez l'extension depuis son fichier zip, ou lancez « composer install » dans son dossier."

#: assets/js/blocks.js:13
msgid "Mobile Money"
msgstr "Mobile Money"
